    <TextView android:id="@+id/rowReleaseTitleEn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/dark_textSecond" android:maxLines="1" android:ellipsize="end" app:layout_constraintStart_toStartOf="@id/rowReleaseTitleRu" app:layout_constraintEnd_toEndOf="@id/guideline_right" app:layout_constraintTop_toBottomOf="@id/rowReleaseTitleRu" />
