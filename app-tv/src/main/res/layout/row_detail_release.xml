<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowReleaseRoot" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="320dp" android:paddingTop="24dp" android:paddingBottom="24dp" android:clipChildren="false" android:clipToPadding="false">
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guideline_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_begin="48dp" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guideline_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_end="48dp" />
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/rowReleaseImageCard"
        android:layout_width="150dp" android:layout_height="214dp" android:scaleType="centerCrop"
        android:background="@color/dark_cardBackground" android:theme="@style/AppTheme.Material"
        app:shapeAppearanceOverlay="@style/AppTheme.RoundedImageView"
        app:layout_constraintStart_toStartOf="@id/guideline_left" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/rowReleaseTitleRu" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="28dp" android:textSize="30sp" android:fontFamily="sans-serif-light" android:textColor="@color/dark_textDefault" android:maxLines="2" android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/rowReleaseImageCard" app:layout_constraintEnd_toEndOf="@id/guideline_right" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/rowReleaseTitleEn" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/dark_textSecond" android:maxLines="1" android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/rowReleaseTitleRu" app:layout_constraintEnd_toEndOf="@id/guideline_right" app:layout_constraintTop_toBottomOf="@id/rowReleaseTitleRu" />
    <TextView android:id="@+id/rowReleaseExtra" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:layout_marginEnd="12dp" android:textSize="14sp" android:textColor="@color/dark_textSecond" android:maxLines="2" android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/rowReleaseTitleRu" app:layout_constraintEnd_toStartOf="@id/rowReleaseHQMarker" app:layout_constraintTop_toBottomOf="@id/rowReleaseTitleEn" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/rowReleaseHQMarker" android:layout_width="32dp" android:layout_height="20dp" android:layout_marginEnd="12dp"
        android:src="@drawable/ic_fullhd" android:visibility="gone" app:tint="@color/dark_textSecond"
        app:layout_constraintEnd_toStartOf="@id/rowReleaseFavoriteCount" app:layout_constraintTop_toTopOf="@id/rowReleaseExtra" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/rowReleaseFavoriteCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="@color/dark_textSecond" android:drawablePadding="4dp" android:visibility="gone"
        app:drawableEndCompat="@drawable/ic_details_favorite" app:drawableTint="@color/dark_textSecond"
        app:layout_constraintEnd_toEndOf="@id/guideline_right" app:layout_constraintTop_toTopOf="@id/rowReleaseExtra" />
    <TextView android:id="@+id/rowReleaseAnnounce" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/dark_textSecond" android:maxLines="2" android:ellipsize="end" android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/rowReleaseTitleRu" app:layout_constraintEnd_toEndOf="@id/guideline_right" app:layout_constraintTop_toBottomOf="@id/rowReleaseExtra" />
    <HorizontalScrollView android:id="@+id/rowReleaseActionsScroll" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:scrollbars="none" android:clipToPadding="false" android:clipChildren="false" android:fillViewport="false"
        app:layout_constraintStart_toStartOf="@id/rowReleaseTitleRu" app:layout_constraintEnd_toEndOf="@id/guideline_right" app:layout_constraintTop_toBottomOf="@id/rowReleaseAnnounce">
        <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/rowReleaseActions" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:clipChildren="false" android:clipToPadding="false" android:orientation="horizontal">
            <Button android:id="@+id/rowReleaseActionContinue" style="?attr/detailsActionButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="Продолжить" android:visibility="gone" android:nextFocusDown="@id/rowReleaseDescriptionCard" />
            <Button android:id="@+id/rowReleaseActionPlay" style="?attr/detailsActionButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="Смотреть" android:nextFocusDown="@id/rowReleaseDescriptionCard" />
            <Button android:id="@+id/rowReleaseActionFavorite" style="?attr/detailsActionButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="В избранное" android:nextFocusDown="@id/rowReleaseDescriptionCard" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/rowReleaseActionOther" style="?attr/detailsActionButtonStyle" android:layout_width="44dp" android:layout_height="44dp" android:minWidth="44dp" android:padding="10dp" android:contentDescription="Другие действия" app:srcCompat="@drawable/ic_more_vert" app:tint="@color/text_button_color" android:nextFocusDown="@id/rowReleaseDescriptionCard" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </HorizontalScrollView>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/rowReleaseDescriptionCard" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/bg_details_description" android:padding="12dp" android:orientation="vertical" android:focusable="true" android:clickable="true"
        android:nextFocusUp="@id/rowReleaseActions"
        app:layout_constraintStart_toStartOf="@id/rowReleaseTitleRu" app:layout_constraintEnd_toEndOf="@id/guideline_right" app:layout_constraintTop_toBottomOf="@id/rowReleaseActionsScroll">
        <TextView android:id="@+id/rowReleaseDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end" android:lineSpacingMultiplier="1.2" android:textSize="14sp" android:textColor="@color/dark_textSecond" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Полное описание" android:textSize="13sp" android:textColor="@color/dark_textDefault" />
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.Barrier android:id="@+id/detailBottom" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="rowReleaseImageCard,rowReleaseDescriptionCard" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/rowReleaseArrow" android:layout_width="24dp" android:layout_height="16dp" android:layout_marginTop="20dp" android:alpha="0.5" android:src="@drawable/ic_wide_arrow_down" app:tint="@color/dark_textSecond" app:layout_constraintTop_toBottomOf="@id/detailBottom" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <ProgressBar android:id="@+id/rowReleaseUpdateProgress" style="?android:progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:visibility="invisible" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/guideline_right" />
    <ProgressBar android:id="@+id/rowReleaseLoadingProgress" android:layout_width="48dp" android:layout_height="48dp" android:visibility="invisible" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
