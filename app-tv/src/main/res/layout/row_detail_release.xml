        <TextView android:id="@+id/rowReleaseExtra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/dark_textSecond" android:maxLines="2" android:ellipsize="end" android:layout_marginEnd="12dp" android:maxWidth="340dp" />
