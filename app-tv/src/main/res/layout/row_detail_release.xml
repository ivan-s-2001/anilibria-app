        <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/rowReleaseActions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp" android:clipChildren="false" android:clipToPadding="false" android:orientation="horizontal">
