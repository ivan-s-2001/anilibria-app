<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/dark_windowBackground" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/tv_screen_inset" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginEnd="@dimen/tv_column_gap">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="AniLiberty TV" android:textSize="@dimen/tv_type_title" android:fontFamily="sans-serif-medium" android:textColor="@color/dark_textDefault" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp"
                android:text="Аниме на большом экране" android:textSize="@dimen/tv_type_display" android:fontFamily="sans-serif-light" android:textColor="@color/dark_textDefault" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="Выберите удобный способ входа или начните смотреть без аккаунта."
                android:textSize="@dimen/tv_type_body" android:lineSpacingMultiplier="1.3" android:textColor="@color/dark_textSecond" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="История и позиция просмотра сохраняются на этом телевизоре. Вход нужен для избранного аккаунта."
                android:textSize="@dimen/tv_type_caption" android:lineSpacingMultiplier="1.3" android:textColor="@color/dark_textSecond" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"
                android:text="Начнём просмотр" android:textSize="@dimen/tv_type_title" android:textColor="@color/dark_textDefault" />
            <LinearLayout android:id="@+id/welcomeCode" style="@style/TvChoice" android:nextFocusDown="@id/welcomeCredentials">
                <TextView style="@style/TvChoiceTitle" android:text="Войти по коду" />
                <TextView style="@style/TvChoiceDescription" android:text="Подтвердите вход на телефоне или сайте" />
            </LinearLayout>
            <LinearLayout android:id="@+id/welcomeCredentials" style="@style/TvChoice" android:nextFocusUp="@id/welcomeCode" android:nextFocusDown="@id/welcomeGuest">
                <TextView style="@style/TvChoiceTitle" android:text="Логин и пароль" />
                <TextView style="@style/TvChoiceDescription" android:text="Ввести данные с помощью пульта" />
            </LinearLayout>
            <LinearLayout android:id="@+id/welcomeGuest" style="@style/TvChoice" android:nextFocusUp="@id/welcomeCredentials">
                <TextView style="@style/TvChoiceTitle" android:text="Продолжить без входа" />
                <TextView style="@style/TvChoiceDescription" android:text="Каталог, поиск и просмотр доступны сразу" />
            </LinearLayout>
            <ProgressBar android:id="@+id/welcomeProgress" style="?android:progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone" />
            <TextView android:id="@+id/welcomeError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"
                android:textSize="@dimen/tv_type_body" android:textColor="@color/dark_textDefault" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
