<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:focusableInTouchMode="true"
    android:paddingHorizontal="48dp" android:paddingTop="28dp"
    android:paddingBottom="24dp" android:background="@color/dark_windowBackground">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="СЕРИИ" android:textSize="14sp" android:textColor="@color/alib_red" />
    <TextView android:id="@+id/episodes_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="26sp" android:textColor="@color/white"
        android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />

    <EditText android:id="@+id/episodes_search" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="12dp" android:paddingHorizontal="12dp"
        android:background="@drawable/bg_tv_episode" android:textColor="@color/white"
        android:textColorHint="@color/dark_textSecond" android:textSize="16sp"
        android:hint="Название или номер серии" android:inputType="text" android:singleLine="true"
        android:imeOptions="actionSearch" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:gravity="center_vertical">
        <Button android:id="@+id/episodes_sort" style="?attr/detailsActionButtonStyle"
            android:layout_width="wrap_content" android:layout_height="48dp" android:text="Сначала первые" />
        <Button android:id="@+id/episodes_filter" style="?attr/detailsActionButtonStyle"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="12dp" android:text="Все серии" />
        <Button android:id="@+id/episodes_mode" style="?attr/detailsActionButtonStyle"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="12dp" android:text="Вид: превью" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/episodes_close" style="?attr/detailsActionButtonStyle"
            android:layout_width="wrap_content" android:layout_height="48dp" android:text="Закрыть" />
    </LinearLayout>

    <TextView android:id="@+id/episodes_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textColor="@color/dark_textSecond" android:layout_marginBottom="12dp" />
    <ProgressBar android:id="@+id/episodes_loading" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="center_horizontal" android:visibility="gone" />
    <Button android:id="@+id/episodes_retry" style="?attr/detailsActionButtonStyle"
        android:layout_width="wrap_content" android:layout_height="48dp" android:text="Повторить"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/episodes_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:padding="4dp" android:scrollbars="vertical"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
