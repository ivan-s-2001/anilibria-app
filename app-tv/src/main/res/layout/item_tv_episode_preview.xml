<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="170dp" android:layout_margin="6dp"
    android:padding="3dp" android:background="@drawable/bg_tv_episode" android:focusable="true" android:clickable="true">
    <ImageView android:id="@+id/episode_preview" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_tv_episode_shade" />
    <TextView android:id="@+id/episode_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:textSize="18sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/episode_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="19sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <TextView android:id="@+id/episode_description" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#DDDDDD" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/episode_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#FFFFFF" android:paddingHorizontal="6dp" android:background="#AA000000" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/episode_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="bottom"
        android:max="1000" android:progressTint="@color/alib_red" android:progressBackgroundTint="#555555" />
</FrameLayout>
